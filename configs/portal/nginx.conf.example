# Install on the selected HTTPS web ingress, NOT on the VPN's occupied :443.
# Replace the upstream address and certificate paths before deployment.
# Keep 8888 private; use a private network or authenticated TLS to the backend.
server {
    listen 443 ssl;
    server_name kynnet.space;
    ssl_certificate /etc/letsencrypt/live/kynnet.space/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/kynnet.space/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 16k;

    location = / { return 302 /web/; }
    location = /web { return 308 /web/; }

    location /web/ {
        # Backend must be locally bound or reached over a private tunnel.
        proxy_pass http://127.0.0.1:8888;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_read_timeout 45s;
        proxy_buffering off;
        # Never log authenticated profile downloads or request bodies.
        access_log off;
        add_header Strict-Transport-Security "max-age=31536000" always;
    }

    location / { return 404; }
}
